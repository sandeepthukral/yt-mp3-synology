# Copy to .env and fill in. .env is gitignored; this file is not.

# Shared secret for the X-Auth-Token header, required by every route but /health.
# Generate one with: openssl rand -hex 24
AUTH_TOKEN=

# Owner applied to files saved into SAVE_DIR. The container runs as root, so
# without these the copies on the share are root-owned and awkward to manage
# from DSM or over SMB. Find yours on the NAS with: id -u && id -g
# Defaults in docker-compose.yml are 1028 (sandeep) and 100 (users).
SAVE_UID=1028
SAVE_GID=100
